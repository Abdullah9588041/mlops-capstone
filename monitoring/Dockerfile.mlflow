# MLflow tracking server image (model registry backend).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
VOLUME /data

RUN pip install --no-cache-dir "mlflow==3.16.1"

EXPOSE 5000

CMD ["mlflow", "server", "--backend-store-uri", "sqlite:////data/mlruns.db", "--host", "0.0.0.0", "--port", "5000"]
